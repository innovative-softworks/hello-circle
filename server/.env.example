# MySQL connection (defaults below match a typical local MySQL install;
# in production point these at Hostinger's — or whichever host's — MySQL).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hello_circle

# Copy to .env and fill in — without these, booking/registration
# confirmations are logged to the console instead of emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Seeded admin account (see server/src/db/seed.ts)
HELLO_CIRCLE_ADMIN_EMAIL=admin@hellocircle.ie
HELLO_CIRCLE_ADMIN_PASSWORD=changeme123

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys).
# Without STRIPE_SECRET_KEY, checkout returns 503 — nothing else breaks.
STRIPE_SECRET_KEY=
# From `stripe listen` (local dev) or the webhook endpoint's signing secret
# (production). Without this, webhooks are accepted unverified — fine for
# local testing, never for anything public.
STRIPE_WEBHOOK_SECRET=
# Where Stripe redirects back to after checkout (the Vite client origin).
CLIENT_URL=http://localhost:5173
