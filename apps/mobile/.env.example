# Copy to .env for local dev (gitignored). Expo automatically inlines any
# EXPO_PUBLIC_-prefixed var into process.env at build/dev time — no
# app.config.ts plumbing needed.
#
# Point this at your machine's LAN IP (not localhost) so a physical device
# on the same network can reach the dev server — Express already binds all
# interfaces, no server-side change needed. Find your LAN IP with
# `ipconfig getifaddr en0` (macOS Wi-Fi) or similar.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3001

# Leave unset locally — no Sentry project exists yet (external account
# step). Crash reporting no-ops without this (see src/lib/sentry.ts).
EXPO_PUBLIC_SENTRY_DSN=
