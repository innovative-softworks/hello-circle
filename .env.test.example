# Copy to .env.test for mocked/read-only settings. This file contains no credentials.
# Phase 3 real auth uses qa:db:setup-generated isolated credentials and the SAME
# variable names below, passed as a sanitized process environment. Do not copy
# development secrets here or manually repoint the real-auth harness.
# mock: real frontend, synthetic API responses, no API server or database.
E2E_MODE=mock
E2E_ENVIRONMENT=local
E2E_BASE_URL=http://127.0.0.1:4177

# Live READ-ONLY API smoke: select an already running local/staging server.
# E2E_MODE=live-readonly
# E2E_ENVIRONMENT=staging
# E2E_BASE_URL=https://your-approved-staging.example
# E2E_STAGING_ORIGIN=https://your-approved-staging.example

# Local real-auth profile contract, checked OFFLINE by qa:preflight.
# qa:preflight -- --current reads generated inputs offline (exit 2 means config
# accepted, not mutation approval). qa:preflight:connected is read-only and must
# verify Docker + actual MySQL identity/grants before guarded mutation commands.
# These example values do not provision resources or enable mutations in qa:e2e.
# Set explicitly in .env.test or the process; placeholders are not runnable credentials.
# NODE_ENV=test
# QA_E2E_ENABLED=true
# QA_PROFILE=auth
# QA_RUN_ID=qa_<8-to-24-lowercase-letters-or-digits>
# E2E_ENVIRONMENT=local
# E2E_BASE_URL=http://127.0.0.1:4178
# E2E_API_URL=http://127.0.0.1:4311
# PORT=4311
# CLIENT_URL=http://127.0.0.1:4178
# PUBLIC_ORIGINS=http://127.0.0.1:4178
# DB_HOST=127.0.0.1
# DB_PORT=13306
# DB_NAME=hello_circle_e2e_<same-QA_RUN_ID>
# DB_USER=hello_circle_qa
# DB_PASSWORD=
# DATA_DIR=<absolute-repository-path>/.qa-data/<same-QA_RUN_ID>
# MEDIA_PROVIDER=local
# CLOUDINARY_UPLOADS_ENABLED=false
# MEDIA_LOCAL_PROCESSING_ENABLED=false
# VITE_MAPBOX_ENABLED=false
# VITE_LAUNCH_MODE=public
# GEOCODER_BASE_URL=http://127.0.0.1:4312
#
# Each email must be distinct and end in @example.test.
# Each password must come from local env/CI secrets or ephemeral generation (12+ characters).
# QA_USER_EMAIL=
# QA_USER_PASSWORD=
# QA_USER_B_EMAIL=
# QA_USER_B_PASSWORD=
# QA_HOST_EMAIL=
# QA_HOST_PASSWORD=
# QA_HOST_B_EMAIL=
# QA_HOST_B_PASSWORD=
# QA_VENDOR_EMAIL=
# QA_VENDOR_PASSWORD=
# QA_VENDOR_B_EMAIL=
# QA_VENDOR_B_PASSWORD=
# QA_ADMIN_EMAIL=
# QA_ADMIN_PASSWORD=
# HELLO_CIRCLE_ADMIN_EMAIL=<same-value-as-QA_ADMIN_EMAIL>
# HELLO_CIRCLE_ADMIN_PASSWORD=<same-value-as-QA_ADMIN_PASSWORD>
# dotenv does NOT expand these placeholders or other variable references automatically.
#
# Auth profile requires STRIPE_*, SMTP_*, R2_*, FIREBASE_*, VITE_FIREBASE_*, AWS_*
# and Cloudinary credentials, Google service-account path, Mapbox token to be ABSENT.
# Even sk_test_ keys are refused until a separate sandbox checkpoint is approved.
# No application .env files are copied into the QA environment.
# qa:db:setup provisions; qa:db:seed initializes/verifies personas;
# qa:db:reset destroys ONLY the verified disposable QA container/database and
# creates a fresh empty run. Seed again explicitly. Never reset hello_circle_dev.
# Runtime/migration DB account is restricted; root is bootstrap-only inside
# the NEW disposable container, never used by application/tests.
