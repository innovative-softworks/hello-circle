# HelloCircle STAGING — client BUILD-TIME environment TEMPLATE (names only).
#
# Vite inlines these into the bundle at `npm run build`, so they are PUBLIC by
# nature (never put a secret here). On the staging host write them to
# client/.env.production.local (gitignored) before building. Every value must
# be a staging value.
# Source of truth: `grep -rhoE "import\.meta\.env\.[A-Z0-9_]+" client/src`.

VITE_LAUNCH_MODE=public            # REQUIRED — must match the server
VITE_VENUE_PAGES_PUBLIC=false      # OPTIONAL — keep false until venue pages launch; must match the server's VENUE_PAGES_PUBLIC
VITE_GTM_CONTAINER_ID=off          # REQUIRED — `off` (no analytics) or a STAGING GTM container (GTM-…); unset would use the PRODUCTION container (HC-QA-093)

VITE_MAPBOX_ENABLED=true           # OPTIONAL — `false` hides maps (list views remain)
VITE_MAPBOX_TOKEN=                 # OPTIONAL — public token URL-restricted to https://<staging-host>

VITE_FIREBASE_API_KEY=             # OPTIONAL — STAGING Firebase web app (unset = Google sign-in unavailable, graceful)
VITE_FIREBASE_AUTH_DOMAIN=         # OPTIONAL
VITE_FIREBASE_PROJECT_ID=          # OPTIONAL
VITE_FIREBASE_APP_ID=              # OPTIONAL

VITE_MEDIA_PUBLIC_DOMAIN=          # OPTIONAL — must equal the server's R2_PUBLIC_DOMAIN (staging)
VITE_MEDIA_IMAGE_RESIZING_ENABLED=false  # OPTIONAL — must equal R2_IMAGE_RESIZING_ENABLED
VITE_CLOUDINARY_CLOUD_NAME=        # OPTIONAL — must equal the server's CLOUDINARY_CLOUD_NAME (staging)

# VITE_STRIPE_PUBLISHABLE_KEY      # NOT USED — hosted Stripe Checkout, no client key
