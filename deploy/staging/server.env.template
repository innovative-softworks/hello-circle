# HelloCircle STAGING — server environment TEMPLATE (variable names only).
#
# Copy to the staging host as  /srv/hellocircle-staging/shared/server.env
# (mode 0600, owner = the service user). Never commit a filled-in copy.
# Every value must be a STAGING value — never a production credential.
# Classification: REQUIRED / OPTIONAL / NOT USED IN STAGING (leave unset).
# Source of truth for names: `grep -rhoE "process\.env\.[A-Z0-9_]+" server/src`.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production            # REQUIRED — production mode (webhook signature enforced, no QA seams)
APP_ENV=staging                # REQUIRED (ops label) — not read by the app today; used by scripts/log tags to tell environments apart
PORT=3002                      # REQUIRED — staging port (production uses 3001 on the shared VPS)
HOST=127.0.0.1                 # REQUIRED — listen on loopback only; nginx is the only way in (HC-QA-103)
TRUST_PROXY_HOPS=1             # REQUIRED — exactly one trusted hop (staging nginx). Valid ONLY because PORT is not reachable except via nginx (see QA_STAGING_PROVISIONING.md §Proxy)
VITE_LAUNCH_MODE=public        # REQUIRED — server reads it too (gated vs public routes); must match the client build

# --- URLs ----------------------------------------------------------------------
CLIENT_URL=                    # REQUIRED — https://<staging-host> (links in emails, Stripe return URLs, sitemap/canonical)
PUBLIC_ORIGINS=                # REQUIRED — https://<staging-host> (CORS allow-list; never reflect arbitrary origins)
PUBLIC_ORIGIN=                 # NOT USED IN STAGING — legacy single-origin alias of PUBLIC_ORIGINS

# --- Database (staging-only DB + user; see QA_STAGING_PROVISIONING.md §Database) ---
DB_HOST=127.0.0.1              # REQUIRED
DB_PORT=3306                   # REQUIRED
DB_NAME=hello_circle_staging   # REQUIRED — never hello_circle / hello_circle_dev
DB_USER=hc_staging_app         # REQUIRED — grants on hello_circle_staging.* only
DB_PASSWORD=                   # REQUIRED — unique to staging

# --- Storage -------------------------------------------------------------------
DATA_DIR=/srv/hellocircle-staging/shared/data   # REQUIRED — uploads/ and private-uploads/ live here (persists across releases)

# --- Admin bootstrap (first boot only) -------------------------------------------
HELLO_CIRCLE_ADMIN_EMAIL=      # REQUIRED — a controlled QA mailbox, not a customer address
HELLO_CIRCLE_ADMIN_PASSWORD=   # REQUIRED — non-default, staging-only

# --- Venue launch gate (HC-QA-059/060) ----------------------------------------------
VENUE_PAGES_PUBLIC=false       # OPTIONAL — keep false until centre/club pages launch; must match VITE_VENUE_PAGES_PUBLIC

# --- Payments: Stripe TEST mode only -----------------------------------------------
STRIPE_SECRET_KEY=             # REQUIRED — sk_test_… / rk_test_… ONLY (a live key must never be placed here)
STRIPE_WEBHOOK_SECRET=         # REQUIRED — whsec_… of the STAGING endpoint https://<staging-host>/api/stripe/webhook
# STRIPE_PUBLISHABLE_KEY       # NOT USED — hosted Checkout; no client-side Stripe key exists in this app
# ALLOW_UNSIGNED_STRIPE_WEBHOOKS  # NOT USED IN STAGING — local-development opt-in only; ignored when NODE_ENV=production or APP_ENV=staging

# --- Email -----------------------------------------------------------------------
SMTP_HOST=                     # REQUIRED — staging sender or sandbox (e.g. a Mailtrap-style inbox); never the production sender
SMTP_PORT=                     # REQUIRED
SMTP_USER=                     # REQUIRED
SMTP_PASS=                     # REQUIRED
MAIL_FROM=                     # REQUIRED — e.g. "HelloCircle Staging <staging@…>" so mail is identifiable

# --- Google sign-in (Firebase Admin) ------------------------------------------------
FIREBASE_PROJECT_ID=           # OPTIONAL — staging Firebase project; unset = Google sign-in shows "not available" (graceful)
FIREBASE_CLIENT_EMAIL=         # OPTIONAL — with the above
FIREBASE_PRIVATE_KEY=          # OPTIONAL — with the above (service account of the STAGING project)

# --- Media ------------------------------------------------------------------------
MEDIA_PROVIDER=local           # REQUIRED — `local` until a staging R2 bucket exists; `r2` only with the staging bucket below
R2_ACCOUNT_ID=                 # OPTIONAL — staging bucket only (rotated credentials; the previously exposed keys must not be reused)
R2_ACCESS_KEY_ID=              # OPTIONAL — token scoped to the staging bucket only
R2_SECRET_ACCESS_KEY=          # OPTIONAL
R2_BUCKET=                     # OPTIONAL — e.g. hellocircle-staging (name must identify staging)
R2_ENDPOINT=                   # OPTIONAL
R2_PUBLIC_DOMAIN=              # OPTIONAL — staging media domain
R2_IMAGE_RESIZING_ENABLED=false  # OPTIONAL
MEDIA_LOCAL_PROCESSING_ENABLED=false  # OPTIONAL — true only with MEDIA_PROVIDER=r2
CLOUDINARY_CLOUD_NAME=         # OPTIONAL — staging cloud/folder only
CLOUDINARY_API_KEY=            # OPTIONAL
CLOUDINARY_API_SECRET=         # OPTIONAL
CLOUDINARY_FOLDER=hellocircle-staging/editorial  # OPTIONAL
CLOUDINARY_UPLOADS_ENABLED=false   # OPTIONAL

# --- Geocoding ----------------------------------------------------------------------
GEOCODER_BASE_URL=             # OPTIONAL — unset = public Nominatim (rate-limited by its policy; fine for low-volume staging)

# --- Content -------------------------------------------------------------------------
TERMS_VERSION=                 # OPTIONAL — defaults to the code's current terms version

# --- Session / cookie secrets ---------------------------------------------------------
# NOT APPLICABLE — sessions are random, DB-backed opaque tokens (no signing secret exists in this codebase).

# --- QA seams: must stay UNSET on staging ------------------------------------------------
# QA_E2E_ENABLED               # NOT USED IN STAGING — local QA harness only
# QA_PAYMENT_PROVIDER_STUB     # NOT USED IN STAGING — local QA harness only
# HC_SERVER_TEST_PROFILE / HC_SERVER_TEST_RUN_ID / HC_LIVE_PROVIDER_TESTS  # NOT USED — server unit-test profile only
